features_conf = configuration_data()

features_conf.set('PACKAGE_NAME', meson.project_name())
features_conf.set('PACKAGE_VERSION', meson.project_version())
features_conf.set('configure_input', 'This file is auto-generated by Meson. Please edit sofia_features.h.in instead.')

configure_file(
  input: 'sofia_features.h.in',
  output: 'sofia_features.h',
  configuration: features_conf,
  install: true,
  install_dir: get_option('includedir') / include_sofiadir / 'sofia-sip')
